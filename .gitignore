# This repo doubles as a case-study archive, so process artefacts are kept
# deliberately (screenshots, raw dumps) rather than ignored.
#
# source/ is where the original inputs go: the expense workbook and the
# itinerary PDF. Add them yourself if you want the archive reproducible.
# The repo is PRIVATE and they contain personal financial data — remove
# source/ before ever making this public.
__pycache__/
*.pyc
.DS_Store

# Traveller names, kept out of version control
names.local.txt

# Original photographs. They carry capture times, device fingerprints and
# often coordinates. scrub_photos.py reads what is useful into
# data/photo_meta.json and writes clean copies to assets/photos/; the
# originals themselves never enter version control.
pics/
